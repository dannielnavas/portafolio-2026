---
interface Props {
    placeholder?: string;
    id?: string;
    name?: string;
}

const {
    placeholder = 'Buscar artículos...',
    id = 'blog-search',
    name = 'search',
} = Astro.props;
---

<div class="relative group">
    <i class="ph-bold ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 group-focus-within:text-black transition-colors"></i>
    <input
        type="text"
        id={id}
        name={name}
        placeholder={placeholder}
        class="w-full bg-gray-50 border border-gray-100 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-black/5 focus:border-black/10 block pl-10 p-3 transition-all outline-none"
        aria-label={placeholder}
    />
</div>

<script>
  const searchInput = document.getElementById('blog-search');
  if (searchInput) {
    let searchTimeout: ReturnType<typeof setTimeout>;
    let lastSearchTerm = '';

    searchInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const searchTerm = target.value.trim();

      // Clear previous timeout
      clearTimeout(searchTimeout);

      // Only track if search term changed and has at least 2 characters
      if (searchTerm !== lastSearchTerm && searchTerm.length >= 2) {
        searchTimeout = setTimeout(() => {
          if (typeof window !== 'undefined' && window.posthog) {
            posthog.capture('blog_search', {
              search_term: searchTerm,
              search_length: searchTerm.length
            });
          }
          lastSearchTerm = searchTerm;
        }, 500); // Debounce de 500ms
      }
    });

    // Track when user presses Enter
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const searchTerm = (e.target as HTMLInputElement).value.trim();
        if (searchTerm && typeof window !== 'undefined' && window.posthog) {
          posthog.capture('blog_search_submit', {
            search_term: searchTerm,
            search_length: searchTerm.length
          });
        }
      }
    });
  }
</script>
