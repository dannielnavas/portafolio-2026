---
interface Props {
    placeholder?: string;
    id?: string;
    name?: string;
}

const {
    placeholder = 'Buscar artículos...',
    id = 'blog-search',
    name = 'search',
} = Astro.props;
---

<div class="relative group">
    <i class="ph-bold ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 group-focus-within:text-black transition-colors"></i>
    <input
        type="text"
        id={id}
        name={name}
        placeholder={placeholder}
        class="w-full bg-gray-50 border border-gray-100 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-black/5 focus:border-black/10 block pl-10 p-3 transition-all outline-none"
        aria-label={placeholder}
    />
</div>
