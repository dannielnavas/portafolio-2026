---
import type { IArticle } from '@/models/articles.ts';
import BlogPostItem from './BlogPostItem.astro';

interface Props {
    postsByYear: Array<{ year: string; posts: IArticle[] }>;
}

const { postsByYear } = Astro.props;
---

<div class="space-y-12">
    {postsByYear.map(({ year, posts }) => (
        <section id={`year-${year}`}>
            <h2 class="text-sm font-bold text-gray-500 border-b border-gray-100 pb-2 mb-4 sticky top-0 bg-white/90 backdrop-blur-sm py-2 z-10">
                {year}
            </h2>
            <div class="flex flex-col gap-1">
                {posts.map((post) => (
                    <BlogPostItem post={post} />
                ))}
            </div>
        </section>
    ))}
</div>
