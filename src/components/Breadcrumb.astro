---
interface Props {
    href: string;
    label: string;
}

const { href, label } = Astro.props;
---

<nav class="mb-10" aria-label="Navegación de breadcrumb">
    <a
        href={href}
        class="text-sm text-gray-500 hover:text-black transition-colors flex items-center gap-1 group"
        aria-label={`${label} - Volver`}
    >
        <i class="ph-bold ph-arrow-left group-hover:-translate-x-1 transition-transform" aria-hidden="true"></i>
        {label}
    </a>
</nav>
