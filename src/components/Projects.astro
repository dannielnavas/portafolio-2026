---
import CardProjects from '@/components/CardProjects.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = [
    {
        title: "DevtoSpanish",
        description: t('projects.devtospanish.description'),
        link: "https://devtospanish.danniel.dev",
        status: "Open Source",
        statusColor: "orange"
    },

    {
        title: "Podcastrek",
        description: t('projects.podcastrek.description'),
        link: "https://github.com/dannielnavas/podcasttreknext/releases",
        status: "Mobile App",
        statusColor: "blue"
    },
]
---
<section class="space-y-8">
    <h2 class="text-xs font-bold text-gray-700 uppercase tracking-widest">{t('projects.heading')}</h2>

    <ul class="space-y-8">
        {projects.map((project) => (
            <CardProjects key={project.title} title={project.title} description={project.description} link={project.link} status={project.status} statusColor={project.statusColor} />
        ))}
    </ul>
</section>
