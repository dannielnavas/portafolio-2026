---
import CardProjects from '@/components/CardProjects.astro';
const projects = [
    {
        title: "DevtoSpanish",
        description: "DevToSpanish es un agregador de contenido técnico que centraliza artículos de Dev.to en español para la comunidad hispana y suma 515 vistas totales estimadas.",
        link: "https://devtospanish.danniel.dev",
        status: "Open Source",
        statusColor: "orange"
    },

    {
        title: "Podcastrek",
        description: " Aplicación para Android que permite escuchar el podcast 'El Lavadero Sónico', perteneciente a la comunidad de Star Trek Colombia. ",
        link: "https://github.com/dannielnavas/podcasttreknext/releases",
        status: "Mobile App",
        statusColor: "blue"
    },
]
---
<section class="space-y-8">
    <h2 class="text-xs font-bold text-gray-700 uppercase tracking-widest">Lo que construyo</h2>

    <ul class="space-y-8">
        {projects.map((project) => (
            <CardProjects key={project.title} title={project.title} description={project.description} link={project.link} status={project.status} statusColor={project.statusColor} />
        ))}
    </ul>
</section>
