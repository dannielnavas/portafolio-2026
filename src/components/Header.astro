---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@/i18n/utils';

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<header class="flex flex-col gap-6">
    <a href={translatePath('/')} class="block w-20 h-20 rounded-full overflow-hidden hover:opacity-90 transition-opacity shadow-sm">
        <img src="/danniel.webp"
             alt="Danniel Navas"
             class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500">
    </a>

    <div>
        <p class="text-3xl font-bold tracking-tight text-black mb-2">
            {t('header.greeting')}
        </p>

        <h1 class="text-xl text-gray-700 font-medium">
            {t('header.title')}
          </h1>
    </div>

    <div class="text-lg text-gray-800 leading-relaxed space-y-4">

        <p>
            {t('header.p1')}
          </p>
          <p set:html={t('header.p2')} />
          <p>
            {t('header.p3')}
          </p>
    </div>

    <div class="flex gap-6 text-gray-500 pt-2">
        <a href="https://linkedin.com/in/luis-daniel-gordo-navas" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors transform hover:scale-110 duration-200" aria-label="LinkedIn" data-social="linkedin"><Icon name="entypo-social:linkedin" size={24} /></a>
        <a href="https://github.com/dannielnavas" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors transform hover:scale-110 duration-200" aria-label="GitHub" data-social="github"><Icon name="entypo-social:github" size={24} /></a>
        <a href="https://youtube.com/@dannieldev2563" target="_blank" rel="noopener noreferrer" class="hover:text-red-600 transition-colors transform hover:scale-110 duration-200" aria-label="YouTube" data-social="youtube"><Icon name="entypo-social:youtube" size={24} /></a>
        <a href="https://x.com/DevDanniel" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors transform hover:scale-110 duration-200" aria-label="X" data-social="twitter"><Icon name="entypo-social:twitter" size={24} /></a>
    </div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-social]').forEach(link => {
    link.addEventListener('click', () => {
      const posthog = (window as any).posthog;
      if (typeof window !== 'undefined' && posthog) {
        posthog.capture('social_link_click', {
          social_platform: link.getAttribute('data-social'),
          social_url: link.href,
          location: 'header'
        });
      }
    });
  });
</script>
</header>

<p class="sr-only">
    Frontend Software Engineer · Fullstack Developer · Software Engineer · Indie Maker · Mentor · Technical Writer
  </p>
