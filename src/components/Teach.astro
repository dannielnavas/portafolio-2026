---
import { Icon } from 'astro-icon/components';
---
<section class="space-y-8">
    <h2 class="text-xs font-bold text-gray-700 uppercase tracking-widest">Lo que enseño</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="https://youtube.com/@dannieldev2563" target="_blank" rel="noopener noreferrer" class="group block p-4 rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors border border-transparent hover:border-gray-200">
            <div class="flex items-center gap-2 mb-2 text-red-600">
                <Icon name="entypo-social:youtube" size={16} />
                <span class="text-xs font-bold text-gray-500 uppercase">Video Reciente</span>
            </div>
            <h3 class="font-semibold text-gray-900 leading-tight group-hover:underline decoration-gray-400 underline-offset-4">
                Instalación y configuración sistema operativo Linux
            </h3>
        </a>

        <a href="/blog" class="group block p-4 rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors border border-transparent hover:border-gray-200">
            <div class="flex items-center gap-2 mb-2 text-gray-700">
                <Icon name="ph:pencil-simple" size={16} />
                <span class="text-xs font-bold text-gray-500 uppercase">Artículo</span>
            </div>
            <h3 class="font-semibold text-gray-900 leading-tight group-hover:underline decoration-gray-400 underline-offset-4">
                Cómo mostrar tus artículos de GitHub dinámicamente
            </h3>
        </a>
    </div>
</section>
