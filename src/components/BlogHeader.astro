---
import SearchInput from './SearchInput.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
    title?: string;
    description?: string;
    totalPosts?: number;
    searchPlaceholder?: string;
}

const {
    totalPosts = 0,
    searchPlaceholder = t('blogHeader.searchPlaceholder')
} = Astro.props;
---

<header class="mb-12">

    <h2 class="text-3xl font-bold tracking-tight text-black mb-4">{t('blogHeader.title')}</h2>
    <p class="text-lg text-gray-600 leading-relaxed mb-8">
        <span set:html={t('blogHeader.description')} />
        {totalPosts > 0 && (
            <span class="text-gray-700 block mt-2 text-sm">
                {totalPosts} {t(totalPosts === 1 ? 'blogHeader.totalOne' : 'blogHeader.totalMany')}
            </span>
        )}
    </p>
    {lang === 'en' && (
        <p class="text-sm text-gray-500 italic mb-6">{t('blogHeader.spanishOnlyNotice')}</p>
    )}

    <SearchInput placeholder={searchPlaceholder} />
</header>
