---
import type { IArticle } from '@/models/articles.ts';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
    article: IArticle;
}

const { article } = Astro.props;
---

<header class="mb-10 pb-10 border-b border-gray-100">
    <div class="flex items-center gap-3 text-sm text-gray-500 font-medium mb-4 flex-wrap">
        <time datetime={article.published_timestamp}>{article.readable_publish_date}</time>
        <span aria-hidden="true">•</span>
        <span>{article.reading_time_minutes} {t('article.readingTime')}</span>
        {article.tags && article.tags.length > 0 && (
            <>
                <span aria-hidden="true">•</span>
                {article.tags.map((tag: string) => (
                    <span
                        id={`tag-${tag}`}
                        class="text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full text-xs font-semibold" /* blue-700 para mejor contraste WCAG AA */
                    >
                        {tag}
                    </span>
                ))}
            </>
        )}
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-black leading-tight mb-6">
        {article.title}
    </h1>
</header>
