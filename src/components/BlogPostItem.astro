---
import type { IArticle } from '@/models/articles.ts';
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils';

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

interface Props {
    post: IArticle;
}

const { post } = Astro.props;
const readLabel = lang === 'en' ? 'Read article' : 'Leer artículo';
---

<a
    href={translatePath(`/blog/${post.slug}`)}
    class="post-item group flex flex-col sm:flex-row sm:items-baseline justify-between py-3 px-2 -mx-2 rounded-md hover:bg-gray-50 transition-colors"
    aria-label={`${readLabel}: ${post.title}`}
    data-post-slug={post.slug}
    data-post-title={post.title}
>
    <h3 class="text-base font-medium text-gray-900 group-hover:text-blue-600 transition-colors">
        {post.title}
    </h3>
    <span class="text-sm text-gray-500 font-mono tabular-nums shrink-0 mt-1 sm:mt-0 sm:ml-4">
        {post.readable_publish_date}
    </span>
</a>

<script>
  const linkElement = document.currentScript?.previousElementSibling;
  if (linkElement) {
    linkElement.addEventListener('click', () => {
      if (typeof window !== 'undefined' && window.posthog) {
        window.posthog.capture('blog_post_click', {
          post_slug: linkElement.getAttribute('data-post-slug'),
          post_title: linkElement.getAttribute('data-post-title'),
          page_type: 'blog_list'
        });
      }
    });
  }
</script>
