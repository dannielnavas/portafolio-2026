---
interface Props {
    name: string;
    role: string;
    bio: string;
    twitterUrl?: string;
    avatarUrl?: string;
}

const {
    name = 'Danniel Navas',
    role = 'Senior Product Engineer',
    bio = 'Escribo sobre la intersección entre buena ingeniería y gran experiencia de usuario.',
    twitterUrl = 'https://x.com/DevDanniel',
    avatarUrl = '/danniel.webp',
} = Astro.props;
---

<div class="mt-16 pt-10 border-t border-gray-100">
    <div class="bg-gray-50 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row gap-6 items-center sm:items-start">
        <img
            src={avatarUrl}
            class="w-16 h-16 rounded-full grayscale"
            alt={name}
            loading="lazy"
        />
        <div>
            <h3 class="font-bold text-lg mb-2">Escrito por {name}</h3>
            <p class="text-gray-600 text-sm mb-4 leading-relaxed">
                {role}. {bio}
                {twitterUrl && (
                    <>
                        {' '}Si te gustó esto, sígueme en{' '}
                        <a
                            href={twitterUrl}
                            class="text-black font-semibold underline hover:text-gray-700 transition-colors"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Seguir a ${name} en Twitter`}
                        >
                            Twitter
                        </a>.
                    </>
                )}
            </p>
        </div>
    </div>
</div>
