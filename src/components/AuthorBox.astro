---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
    name: string;
    role: string;
    bio: string;
    twitterUrl?: string;
    avatarUrl?: string;
}

const {
    name = 'Danniel Navas',
    role = 'Senior Product Engineer',
    bio = t('authorBox.bio'),
    twitterUrl = 'https://x.com/DevDanniel',
    avatarUrl = '/danniel.webp',
} = Astro.props;
---

<div class="mt-16 pt-10 border-t border-gray-100">
    <div class="bg-gray-50 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row gap-6 items-center sm:items-start">
        <img
            src={avatarUrl}
            class="w-16 h-16 rounded-full grayscale"
            alt={name}
            loading="lazy"
        />
        <div>
            <h3 class="font-bold text-lg mb-2">{t('authorBox.writtenBy')} {name}</h3>
            <p class="text-gray-600 text-sm mb-4 leading-relaxed">
                {role}. {bio}
                {twitterUrl && (
                    <>
                        {' '}{t('authorBox.followIntro')}{' '}
                        <a
                            href={twitterUrl}
                            class="text-black font-semibold underline hover:text-gray-700 transition-colors"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${t('authorBox.followIntro')} ${name} - ${t('authorBox.followOn')}`}
                        >
                            {t('authorBox.followOn')}
                        </a>.
                    </>
                )}
            </p>
        </div>
    </div>
</div>
