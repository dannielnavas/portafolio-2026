---
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/Footer.astro';
import { useTranslations } from '@/i18n/utils';

const t = useTranslations('en');
---

<Layout
  title={t('404.title')}
  description={t('404.description')}
  canonicalURL="https://danniel.dev/en/404"
>
  <hr class="border-gray-100">

  <div class="flex flex-col items-center justify-center py-24 space-y-8 text-center">
    <div class="space-y-4">
      <h1 class="text-6xl font-bold text-black tracking-tight">404</h1>
      <p class="text-xl text-gray-600 font-medium">
        {t('404.heading')}
      </p>
    </div>

    <p class="text-lg text-gray-500 max-w-md leading-relaxed">
      {t('404.body')}
    </p>

    <div class="pt-4">
      <a
        href="/en"
        class="link-hover inline-block text-lg font-semibold text-black"
      >
        {t('nav.backHome')}
      </a>
    </div>
  </div>

  <Footer />
</Layout>
<script>
  if (typeof window !== 'undefined' && (window as any).posthog) {
    (window as any).posthog.capture('404_page_view', {
      page_path: window.location.pathname,
      page_title: '404 - Page Not Found',
      locale: 'en'
    });
  }
</script>
