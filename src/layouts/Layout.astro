---
import '@/styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import PostHog from '@/components/posthog.astro';

const {
    title = 'Daniel Navas - Desarrollador Web',
    description = 'Senior Product Engineer con más de 13 años construyendo productos digitales sobrios, útiles y duraderos.',
    canonicalURL = 'https://danniel.dev',
} = Astro.props;

const siteUrl = Astro.site ?? 'https://danniel.dev';
const canonical = canonicalURL ?? siteUrl;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta
    property="og:description"
    content={description}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Danniel Navas" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content="https://danniel.dev/og/home.png" />


    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
    name="twitter:description"
    content={description}
    />
    <meta name="twitter:image" content="https://danniel.dev/og/home.png" />
    <meta name="twitter:creator" content="@DevDanniel" />


    <!-- Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Styles -->
    <!-- <link rel="stylesheet" href="/styles/global.css" /> -->

    <!-- Performance -->
    <meta name="theme-color" content="#ffffff" />
    <PostHog />
  </head>

  <body class="antialiased min-h-screen flex justify-center py-16 px-6 sm:px-12 bg-white selection:bg-gray-100">
    <main class="max-w-[640px] w-full space-y-12">
      <slot />
    </main>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Danniel Navas",
      "jobTitle": "Senior Product Engineer",
      "description": description,
      "url": siteUrl,
      "sameAs": [
        "https://dev.to/dannieldev",
        "https://github.com/dannielnavas",
        "https://www.linkedin.com/in/luis-daniel-gordo-navas",
        "https://x.com/DevDanniel"
      ],
      "knowsAbout": [
        "Frontend Development",
        "Fullstack Development",
        "JavaScript",
        "Software Engineering",
        "Product Development",
        "Mentoring"
      ]
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": title,
      "url": siteUrl,
      "description": description,
      "publisher": {
        "@type": "Person",
        "name": "Danniel Navas",
        "url": siteUrl
      }
    })} />

  </body>
</html>
